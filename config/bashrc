# ============================================================
# 用户 shell 配置 — 持久化到宿主机 ./config/bashrc
#
# 这份文件在容器里同时挂在两处 (见 docker-compose.yaml):
#     /home/coder/.bashrc   ← 镜像默认运行用户 coder(uid 1000) 的 ~/.bashrc
#     /root/.bashrc         ← docker exec -u root 时生效的那份
# 所以在容器里直接 `vim ~/.bashrc` 改的就是宿主机上的这一份, 重建容器/换镜像都不丢。
# ============================================================

# 1) 默认的环境初始化 (Debian/Ubuntu 常规做法, 保留系统行为:
#    设置 PS1、ls 颜色别名、history 等)
if [ -f /etc/bash.bashrc ]; then
    . /etc/bash.bashrc
fi

# 2) PATH
#    code-server 的网页终端是**非登录交互 shell**, 只读 ~/.bashrc, 不读 /etc/profile,
#    所以 PATH 必须在这里导出一次 (与 /etc/profile.d/dev-path.sh 保持一致)。
#    /opt/opencode/bin 放最前: opencode 热升级卷的挂载点, 有二进制时优先于
#    镜像内烧录的 /usr/local/bin/opencode。
export PATH="/opt/opencode/bin:/usr/local/go/bin:/home/coder/.local/bin:$PATH"

# 3) 语言与时区
export LANG="${LANG:-C.UTF-8}"
export TZ="${TZ:-Asia/Shanghai}"

# 4) 提示符里带上容器名 / k8s 感知的状态, 便于区分多个开发容器
export PROMPT_DIRTRIM=3

# ============================================================
# 5) 你自己的别名 / 环境变量 — 写在这里, 重建容器后依然保留
# ============================================================
# 例:
# alias ll='ls -alF'
# alias gs='git status -sb'
# export HTTP_PROXY=http://your-proxy:7890
# export PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#
# opencode 便捷入口 (装了 opencode 才有用)
# alias oc='opencode'
